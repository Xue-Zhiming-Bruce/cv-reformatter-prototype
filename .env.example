# Copy to .env for local development. Never commit .env.
LLM_PROVIDER=openai

# Generic provider credentials. Keep values blank in this example file.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Candidate extraction stage. Stage-specific keys override generic keys.
OPENAI_EXTRACT_API_KEY=
OPENAI_EXTRACT_MODEL=gpt-5.4-mini
ANTHROPIC_EXTRACT_API_KEY=
ANTHROPIC_EXTRACT_MODEL=

# Template design is opt-in and remains subject to provider-policy gates.
TEMPLATE_DESIGN_STRATEGY=measured_template
TEMPLATE_DESIGN_LIVE_ENABLED=0
OPENAI_DESIGN_API_KEY=
OPENAI_DESIGN_MODEL=gpt-5.4-mini
ANTHROPIC_DESIGN_API_KEY=
ANTHROPIC_DESIGN_MODEL=

# Uploaded measured-PDF API proofs/previews default to the bounded Agentic loop.
# Use agentic only for inputs authorized under the existing provider policy.
# Switching strategy/model/budgets requires new short/medium/long proof approval.
# Native no-target generation keeps the shared deterministic template renderer.
GENERATION_STRATEGY=agentic
DEEPSEEK_API_KEY=
# Optional compatible endpoint; an empty value keeps the existing DeepSeek default.
DEEPSEEK_BASE_URL=
A_PIPELINE_MODEL=deepseek-flash
AGENTIC_MAX_MODEL_REQUESTS=12
AGENTIC_MAX_TOOL_CALLS=24
AGENTIC_MAX_REPAIR_ROUNDS=2

# Adobe target-PDF analysis. PDF export uses headless Chrome.
ADOBE_PDF_SERVICES_CLIENT_ID=
ADOBE_PDF_SERVICES_CLIENT_SECRET=
ADOBE_PDF_SERVICES_REGION=US
ADOBE_PDF_SERVICES_TIMEOUT_SECONDS=180
# Existing COMMERCIAL_BAKEOFF_TIMEOUT_SECONDS remains a fallback when the above is unset.
