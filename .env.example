# Copy to .env for local development. Never commit .env.
LLM_PROVIDER=openai

# Generic provider credentials. Keep values blank in this example file.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Candidate extraction stage. Stage-specific keys override generic keys.
CANDIDATE_SEGMENTATION=deterministic
OPENAI_EXTRACT_API_KEY=
OPENAI_EXTRACT_MODEL=gpt-5.4-mini
ANTHROPIC_EXTRACT_API_KEY=
ANTHROPIC_EXTRACT_MODEL=

# Template design is opt-in and remains subject to provider-policy gates.
TEMPLATE_DESIGN_STRATEGY=measured_template
TEMPLATE_DESIGN_LIVE_ENABLED=0
OPENAI_DESIGN_API_KEY=
OPENAI_DESIGN_MODEL=gpt-5.4-mini
ANTHROPIC_DESIGN_API_KEY=
ANTHROPIC_DESIGN_MODEL=

# Commercial target-analysis evaluation. Names only; never commit values.
# NOTE: HTML-to-PDF export no longer uses Adobe (headless Chrome since 2026-08-30);
# these Adobe credentials are target-analysis / commercial-harness evaluation only.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30
ADOBE_PDF_SERVICES_CLIENT_ID=
ADOBE_PDF_SERVICES_CLIENT_SECRET=
ADOBE_PDF_SERVICES_REGION=US
PDFREST_API_KEY=
PDFREST_API_BASE_URL=https://api.pdfrest.com
FOXIT_PDF_SERVICES_CLIENT_ID=
FOXIT_PDF_SERVICES_CLIENT_SECRET=
FOXIT_PDF_SERVICES_BASE_URL=https://na1.fusion.foxit.com/pdf-services/api
APRYSE_LICENSE_KEY=
ASPOSE_WORDS_LICENSE_PATH=
ASPOSE_WORDS_METERED_PUBLIC_KEY=
ASPOSE_WORDS_METERED_PRIVATE_KEY=
COMMERCIAL_BAKEOFF_TIMEOUT_SECONDS=180
COMMERCIAL_BAKEOFF_POLL_SECONDS=2
